package Exercicios1;
import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
public class AlunoTeste{


    public static void main(String[] args) {

        String ficheiro = "alunos.csv";

        try {

            BufferedReader br = new BufferedReader(new FileReader(ficheiro));

            String linha;

            while ((linha = br.readLine()) != null) {

                String[] dados = linha.split(",");

                String nome = dados[0];

                int[] notas = new int[dados.length - 1];

                for (int i = 1; i < dados.length; i++) {
                    notas[i - 1] = Integer.parseInt(dados[i]);
                }

                Aluno aluno = new Aluno(nome, notas);

                System.out.println("--------------------------------");

                aluno.mostrarDados();

                aluno.ordenarNotas();

                System.out.print("Notas Ordenadas: ");

                for (int nota : aluno.getNotas()) {
                    System.out.print(nota + " ");
                }

                System.out.println("\n");

            }

            br.close();

        } catch (IOException e) {

            System.out.println("Erro ao ler o ficheiro.");

        }

    }

}



