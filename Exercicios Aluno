package Exercicios1;

    public class Aluno {
    

    private String nome;
    private int[] notas;

    public Aluno(String nome, int[] notas) {
        this.nome = nome;
        this.notas = notas;
    }


    public String getNome() {
        return nome;
    }

    public int[] getNotas() {
        return notas;
    }


    public double calcularMedia() {

        return (notas[0] * 0.30) +
               (notas[1] * 0.10) +
               (notas[2] * 0.35);
    }

    public void ordenarNotas() {

        for (int i = 0; i < notas.length - 1; i++) {

            for (int j = 0; j < notas.length - 1 - i; j++) {

                if (notas[j] > notas[j + 1]) {

                    int aux = notas[j];
                    notas[j] = notas[j + 1];
                    notas[j + 1] = aux;
                }
            }
        }
    }

    // Mostrar dados do aluno
    public void mortarDados() {

        System.out.println("Aluno: " + nome);

        System.out.print("Notas: ");

        for (int nota : notas) {
            System.out.print(nota + " ");
        }

        System.out.printf("\nMédia: %.2f\n", calcularMedia());
    }

}

